# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string used by Drizzle ORM (lib/db/client.ts) and
# drizzle-kit (drizzle.config.ts). Works with any managed Postgres provider
# (Neon, Supabase, Vercel Postgres, Railway, RDS, etc.) or a local instance.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# --- Admin auth ---

# Signs/verifies admin AND customer session cookies (lib/auth/session.ts).
# Generate a long random value, e.g.: openssl rand -base64 32
# Changing this value invalidates every existing admin and customer session.
SESSION_SECRET="generate-a-long-random-string"

# Used only by `npm run db:seed-admin` (lib/db/seed-admin.ts) to create your
# initial admin account. Not read anywhere else, and never shown in any UI.
# Re-running db:seed-admin after changing ADMIN_PASSWORD updates that
# account's password.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="choose-a-real-password-min-8-chars"
ADMIN_NAME="Store Admin"

# --- Email notifications (lib/notifications/email.ts) ---

# API key from your Resend account (https://resend.com). Required to send
# order-confirmation and order-status-update emails. If unset, email sending
# fails clearly and the failure is logged — it does NOT stop an order from
# being created or an admin update from succeeding.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# The address emails are sent from. Must be on a domain you've verified with
# Resend (their sandbox domain only works for sending to your own account's
# email while testing).
EMAIL_FROM_ADDRESS="orders@yourdomain.com"

# Optional. Display name shown alongside EMAIL_FROM_ADDRESS. Defaults to
# "Shop AI" if unset.
EMAIL_FROM_NAME="Shop AI"

# --- WhatsApp notifications (lib/notifications/whatsapp.ts) ---

# From the official WhatsApp Cloud API (Meta Business Manager -> your app ->
# WhatsApp -> API Setup). Required to send order-confirmation and
# order-status-update WhatsApp messages. If unset, sending fails clearly and
# the failure is logged — it does NOT stop an order from being created or
# an admin update from succeeding.
WHATSAPP_ACCESS_TOKEN="your-whatsapp-cloud-api-access-token"

# The "Phone number ID" (not the phone number itself) shown in the same
# Meta Business Manager API Setup page.
WHATSAPP_PHONE_NUMBER_ID="123456789012345"

# Optional. Used to turn a locally-formatted customer number (e.g.
# "03001234567", with no country code) into the international format the
# WhatsApp API requires. Defaults to "92" (Pakistan) if unset, matching
# this project's current locale (see lib/format.ts's "en-PK" formatting).
# Numbers already given with a leading "+" are unaffected by this setting.
WHATSAPP_DEFAULT_COUNTRY_CODE="92"
